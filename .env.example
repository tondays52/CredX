# CredX Protocol — Environment Configuration
# Copy this file to .env and fill in your values

# Private key of deployer / testing wallet (with 0x prefix)
PRIVATE_KEY=

# Creditcoin Testnet (CC3) RPC Endpoint
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Ethereum Sepolia Testnet RPC Endpoint
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Attestcoin / USC Native Precompile Address on Creditcoin
ATTESTCOIN_PRECOMPILE=0x0000000000000000000000000000000000000FD2

# Set to true to force deploying MockAttestationOracle even on Creditcoin networks
FORCE_MOCK_ORACLE=false
