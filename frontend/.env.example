# PostHog browser analytics (Vite exposes only VITE_-prefixed variables to the client)
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Google Maps JS API key (optional) — set your OWN key here; without it the map falls
# back to the free OpenStreetMap layer. NEVER commit a real key.
VITE_GOOGLE_MAPS_API_KEY=

# RapidAPI Binance43 key (optional) — enables live candle fetches in the macro
# liquidity chart; when unset the chart uses its local price path. NEVER commit a real key.
VITE_RAPIDAPI_KEY=
